# ==============================================================================
# CoSpace - Variables de Entorno de Ejemplo (.env.example)
# Duplica este archivo como .env y completa las credenciales de tu proyecto.
# ==============================================================================

# Conexión a la base de datos PostgreSQL (Supabase Connection Pooling / PgBouncer)
# Utilizada por Prisma Client en tiempo de ejecución (Puerto 5432 o 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Conexión directa a la base de datos PostgreSQL (Sin Pooler)
# Requerida para ejecutar migraciones y comandos directos de Prisma CLI
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Secretos criptográficos para la firma y verificación de JSON Web Tokens (JWT)
# Generar claves seguras con: openssl rand -base64 32
JWT_ACCESS_SECRET="tu_clave_secreta_para_access_tokens_minimo_32_caracteres"
JWT_REFRESH_SECRET="tu_clave_secreta_para_refresh_tokens_minimo_32_caracteres"

# Tiempos de expiración de sesiones (Access: 15 minutos, Refresh: 7 días)
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# URL base pública del frontend de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
